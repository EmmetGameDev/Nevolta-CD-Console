    pinMode(BUTTON_X_PIN, INPUT_PULLUP);
    debouncerX.attach(BUTTON_X_PIN);
    debouncerX.interval(25);

    pinMode(BUTTON_Y_PIN, INPUT_PULLUP);
    debouncerY.attach(BUTTON_Y_PIN);
    debouncerY.interval(25);

    pinMode(BUTTON_5_PIN, INPUT_PULLUP);
    debouncer5.attach(BUTTON_5_PIN);
    debouncer5.interval(25);

    pinMode(BUTTON_6_PIN, INPUT_PULLUP);
    debouncer6.attach(BUTTON_6_PIN);
    debouncer6.interval(25);

    pinMode(BUTTON_7_PIN, INPUT_PULLUP);
    debouncer7.attach(BUTTON_7_PIN);
