    // -------------------------
    // Right stick press
    // -------------------------

    pinMode(RIGHT_STICK_PRESS_PIN, INPUT_PULLUP);

    debouncerRightStickPress.attach(RIGHT_STICK_PRESS_PIN);
    debouncerRightStickPress.interval(25);


    // -------------------------
    // D-pad
    // -------------------------

    pinMode(HAT_LEFT_PIN, INPUT_PULLUP);
    pinMode(HAT_DOWN_PIN, INPUT_PULLUP);
    pinMode(HAT_RIGHT_PIN, INPUT_PULLUP);
    pinMode(HAT_UP_PIN, INPUT_PULLUP);

    debouncerHatLeft.attach(HAT_LEFT_PIN);
    debouncerHatLeft.interval(25);

    debouncerHatDown.attach(HAT_DOWN_PIN);
    debouncerHatDown.interval(25);

