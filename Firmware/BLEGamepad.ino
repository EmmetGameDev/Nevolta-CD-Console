void setup()
{
    // -------------------------
    // ADC
    // -------------------------

    analogReadResolution(12);
    analogSetPinAttenuation(BATTERY_ADC_PIN, ADC_11db);
    analogSetPinAttenuation(CHARGE_ADC_PIN, ADC_11db);

    Wire.begin();
    display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
    display.clearDisplay();
    display.display();

    float chargeRaw = analogRead(CHARGE_ADC_PIN);
    if(chargeRaw > 2045){
        chargingMode = true;
        pinMode(BUTTON_18_PIN, INPUT_PULLUP);
        debouncer18.attach(BUTTON_18_PIN);
        debouncer18.interval(25);
        wakeOLED();
    }else{
        chargingMode = false;
        initializeGamePad();
    }

    Serial.begin(115200);
}


void loop()
{
    float adcRaw = analogRead(BATTERY_ADC_PIN);
    float batteryPerc = (adcRaw / 4095.0f) * 100;

    unsigned long currentMillis = millis();
    debouncer18.update();

    if (debouncer18.fell() && isOLEDon == false){
        wakeOLED();
    }

    if(chargingMode == false){
            
        bool currentPairedState = false;
        // -------------------------
        // Update debouncers
        // -------------------------

        debouncerA.update();
        debouncerB.update();
        debouncerX.update();
        debouncerY.update();

        debouncer5.update();
        debouncer6.update();
        debouncer7.update();
        debouncer8.update();
        debouncer9.update();

        debouncer15.update();
        debouncer16.update();

        debouncerRightStickPress.update();

        debouncerHatLeft.update();
        debouncerHatDown.update();
        debouncerHatRight.update();
        debouncerHatUp.update();


        // Battery Info on display
        bleGamepad.setBatteryLevel(batteryPerc);
        bleGamepad.setPowerLevel(POWER_STATE_GOOD);

        if(isOLEDon == true){
            display.fillRect(93, 0, 35, 10, BLACK);
            if(batteryPerc >= 80){
                display.drawBitmap(108, 0, Batt_100, 20, 10, 1);
            }else if(batteryPerc >= 60){
                display.drawBitmap(108, 0, Batt_80, 20, 10, 1);
            }else if(batteryPerc >= 40){
                display.drawBitmap(108, 0, Batt_60, 20, 10, 1);
            }else if(batteryPerc >= 20){
                display.drawBitmap(108, 0, Batt_40, 20, 10, 1);
            }else{
                display.drawBitmap(108, 0, Batt_20, 20, 10, 1);
            }
        }

        if(batteryPerc >= 20){
            bleGamepad.setPowerLevel(POWER_STATE_CRITICAL);
        }
        
        float chargeRaw = analogRead(CHARGE_ADC_PIN);
        if(chargeRaw > 2045){
            bleGamepad.setChargingState(POWER_STATE_CHARGING);
            if(isOLEDon == true){
                display.drawBitmap(93, 0, Batt_Charge, 10, 10, 1);
            }
        }else{
            bleGamepad.setChargingState(POWER_STATE_NOT_CHARGING);
        }

        if (bleGamepad.isConnected())
        {
            currentPairedState = true;

            // -------------------------
            // BUTTON 1 - A
            // -------------------------

            if (debouncerA.fell())
                bleGamepad.press(BUTTON_1);

            if (debouncerA.rose())
                bleGamepad.release(BUTTON_1);


            // -------------------------
            // BUTTON 2 - B
            // -------------------------

            if (debouncerB.fell())
                bleGamepad.press(BUTTON_2);

            if (debouncerB.rose())
                bleGamepad.release(BUTTON_2);


            // -------------------------
            // BUTTON 3 - X
            // -------------------------

            if (debouncerX.fell())
                bleGamepad.press(BUTTON_3);

            if (debouncerX.rose())
                bleGamepad.release(BUTTON_3);


            // -------------------------
            // BUTTON 4 - Y
            // -------------------------

            if (debouncerY.fell())
                bleGamepad.press(BUTTON_4);

            if (debouncerY.rose())
                bleGamepad.release(BUTTON_4);


            // -------------------------
            // BUTTON 5
            // -------------------------

            if (debouncer5.fell())
                bleGamepad.press(BUTTON_5);

            if (debouncer5.rose())
                bleGamepad.release(BUTTON_5);


            // -------------------------
            // BUTTON 6
            // -------------------------

            if (debouncer6.fell())
                bleGamepad.press(BUTTON_6);

            if (debouncer6.rose())
                bleGamepad.release(BUTTON_6);


            // -------------------------
            // BUTTON 7
            // -------------------------

            if (debouncer7.fell())
                bleGamepad.press(BUTTON_7);

            if (debouncer7.rose())
                bleGamepad.release(BUTTON_7);


            // -------------------------
            // BUTTON 8
            // -------------------------

            if (debouncer8.fell())
                bleGamepad.press(BUTTON_8);

            if (debouncer8.rose())
                bleGamepad.release(BUTTON_8);


            // -------------------------
            // BUTTON 9
            // -------------------------

            if (debouncer9.fell())
                bleGamepad.press(BUTTON_9);

            if (debouncer9.rose())
                bleGamepad.release(BUTTON_9);


            // -------------------------
            // BUTTON 15
            // -------------------------

            if (debouncer15.fell())
                bleGamepad.press(BUTTON_15);

            if (debouncer15.rose())
                bleGamepad.release(BUTTON_15);


            // -------------------------
            // BUTTON 16
            // -------------------------

            if (debouncer16.fell())
                bleGamepad.press(BUTTON_16);

            if (debouncer16.rose())
                bleGamepad.release(BUTTON_16);


            // -------------------------
            // BUTTON 18
            // -------------------------

            if (debouncer18.fell())
            {
                bleGamepad.press(BUTTON_11);
                if(isOLEDon == false){
                    wakeOLED();
                }
            }

            if (debouncer18.rose())
            {
                bleGamepad.release(BUTTON_11);
            }


            // -------------------------
            // RIGHT STICK PRESS
            // -------------------------

            if (debouncerRightStickPress.fell())
                bleGamepad.press(BUTTON_10);

            if (debouncerRightStickPress.rose())
                bleGamepad.release(BUTTON_10);


            // -------------------------
            // D-pad
            // -------------------------

            bool left  = debouncerHatLeft.read()  == LOW;
            bool down  = debouncerHatDown.read()  == LOW;
            bool right = debouncerHatRight.read() == LOW;
            bool up    = debouncerHatUp.read()    == LOW;


            if (up && right)
            {
                bleGamepad.setHat1(HAT_UP_RIGHT);
            }
            else if (up && left)
            {
                bleGamepad.setHat1(HAT_UP_LEFT);
            }
            else if (down && right)
            {
                bleGamepad.setHat1(HAT_DOWN_RIGHT);
            }
            else if (down && left)
            {
                bleGamepad.setHat1(HAT_DOWN_LEFT);
            }
            else if (up)
            {
                bleGamepad.setHat1(HAT_UP);
            }
            else if (down)
            {
                bleGamepad.setHat1(HAT_DOWN);
            }
            else if (left)
            {
                bleGamepad.setHat1(HAT_LEFT);
            }
            else if (right)
            {
                bleGamepad.setHat1(HAT_RIGHT);
            }
            else
            {
                bleGamepad.setHat1(HAT_CENTERED);
            }


            // -------------------------
            // LEFT ANALOG STICK
            // -------------------------

            int leftX = analogRead(JOYSTICK_X_PIN);
            int leftY = analogRead(JOYSTICK_Y_PIN);

            int leftXMapped = -mapJoystick(leftX, 1960);
            int leftYMapped = mapJoystick(leftY, 1960);


            // -------------------------
            // RIGHT ANALOG STICK
            // -------------------------

            int rightX = analogRead(RIGHT_JOYSTICK_X_PIN);
            int rightY = analogRead(RIGHT_JOYSTICK_Y_PIN);

            int rightXMapped = -mapJoystick(rightX, 1960);
            int rightYMapped = mapJoystick(rightY, 1960);


            // -------------------------
            // Send both sticks
            // -------------------------

            bleGamepad.setAxes(
                leftXMapped,     // X
                leftYMapped,     // Y
                rightXMapped,    // Z
                0,               // RX
                rightYMapped,    // RY
                0                // RZ
            );


            // -------------------------
            // Send report
            // -------------------------
            
            bleGamepad.sendReport();


            // -------------------------
            // Debug
            // -------------------------

            /*
            Serial.printf(
                "L: X%d Y%d | R: X%d Y%d\n",
                leftX,
                leftY,
                rightX,
                rightY
            );
            */
        }

        if(lastPairedState == false){
            if(currentPairedState == true){
                wakeOLED();
                display.setTextSize(1);
                display.fillRect(5, 15, 90, 10, BLACK);
                display.setCursor(5, 15);
                String scrText = "Device paired!";
                for(int i = 0; i < scrText.length(); i++){
                    display.print(scrText[i]);
                    display.display();
                    delay(75);
                }
                delay(3000);
                display.fillRect(5, 15, 90, 10, BLACK);
                display.display();
            }else {
                if(isOLEDon == true){
                    display.fillRect(5, 15, 90, 10, BLACK);
                    display.setTextSize(1);
                    display.setCursor(5, 15);
                    display.print("Searching");
                    display.display();
                    delay(300);
                    for(int i = 0; i < 3; i++){
                        display.print(".");
                        display.display();
                        delay(300);
                    }   
                }
            }
        }
        if(isOLEDon == true){
            display.display();
        }
        lastPairedState = currentPairedState;
    }else{
        if(currentMillis - bat_previousMillis >= bat_interval){
            bat_previousMillis = currentMillis;
            float chargeRaw = analogRead(CHARGE_ADC_PIN);

            if(isOLEDon == true){
                display.clearDisplay();

                if(batteryPerc >= 80){
                    display.drawBitmap(0, 0, Charge_100, 128, 32, 1);
                    display.display();
                }else{
                    if(batteryPerc >= 60){
                        display.drawBitmap(0, 0, Charge_80, 128, 32, 1);
                    }else if(batteryPerc >= 40){
                        display.drawBitmap(0, 0, Charge_60, 128, 32, 1);
                    }else if(batteryPerc >= 20){
                        display.drawBitmap(0, 0, Charge_40, 128, 32, 1);
                    }else{
                        display.drawBitmap(0, 0, Charge_20, 128, 32, 1);
                    }
                    display.drawBitmap(20, 15, Dots_1, 21, 2, 1, 0);
                    display.display();
                    delay(250);
                    display.drawBitmap(20, 15, Dots_2, 21, 2, 1, 0);
                    display.display();
                    delay(250);
                    display.drawBitmap(20, 15, Dots_3, 21, 2, 1, 0);
                    display.display();
                    delay(250);
                    display.drawBitmap(20, 15, Dots_4, 21, 2, 1, 0);
                    display.display();
                    delay(250);
                }
            }

            if(chargeRaw < 2045){
                chargingMode = false;
                initializeGamePad();
            }
        }
    }

    if(isOLEDon == true){
        if (currentMillis - previousMillis >= interval)
        {
            previousMillis = currentMillis;
            display.ssd1306_command(SSD1306_DISPLAYOFF);
            isOLEDon = false;
        }
    }
}